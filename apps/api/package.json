    "rxjs": "^7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "^22",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
