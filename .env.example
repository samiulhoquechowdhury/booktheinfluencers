# Local services from docker-compose.yml (`pnpm db:up`)
DATABASE_URL=postgresql://talent:talent@localhost:5442/talent_dev
REDIS_URL=redis://localhost:6392

# apps/api
PORT=4100
# Encrypts artists' ID documents. Required in production: `openssl rand -base64 32`.
# Keep it outside the database and back it up: without it, stored IDs can't be read.
# ID_DOCUMENT_KEY=
# Demo-only shortcuts for local development — the API refuses these in production.
OTP_DEMO_CODE=123456
MFA_DEMO_CODE=123456

# apps/web and apps/admin: leave both unset to run on the in-browser mock.
# Set both to use apps/api: the browser calls /v1/*, which Next forwards to API_URL.
# NEXT_PUBLIC_API_BASE=/v1
# API_URL=http://localhost:4100
