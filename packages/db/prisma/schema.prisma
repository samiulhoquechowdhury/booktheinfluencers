// Data model — docs/trd.md §4, plus the records the web/admin frontends added
// (messages, contact requests, artist applications, newsletter, sessions).
// Money is integer paise (BigInt); percentages are basis points (Int).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  SALES
  TALENT_MANAGER
  OPS
  ACCOUNTS
  TALENT
  REP
  CUSTOMER
}

enum RepresentationType {
  TALENT_MANAGED
  AGENCY_MANAGED
  PLATFORM_COORDINATED
}

enum ProfileStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum TalentTier {
  STANDARD
  PREMIUM
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum LeadStage {
  NEW
  CONTACTED
  REQUIREMENT_RECEIVED
  SHORTLISTED
  AVAILABILITY_CHECK
  QUOTE_SENT
  NEGOTIATION
  ADVANCE_PENDING
  CONFIRMED
  EVENT_COMPLETED
  SETTLEMENT
  CLOSED
  LOST
  CANCELLED
}

enum AvailabilityStatus {
  NOT_CHECKED
  AWAITING_MANAGER
  HOLD_REQUESTED
  AVAILABLE
  TENTATIVE
  UNAVAILABLE
  CONFIRMED
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum LineItemType {
  TALENT_FEE
  TRAVEL
  ACCOMMODATION
  LOCAL_TRANSPORT
  SECURITY
  PRODUCTION
  SERVICE_FEE
  OTHER
}

enum ContractStatus {
  DRAFT
  SENT
  PARTIALLY_SIGNED
  SIGNED
  VOID
}

enum MilestoneStatus {
  PENDING
  LINK_SENT
  PAID
  OVERDUE
  REFUNDED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  SCHEDULED
  PAID
  ON_HOLD
}

enum MessageAuthor {
  CUSTOMER
  TALENT
  STAFF
}

enum ApplicationStatus {
  NEW
  REVIEWING
  INVITED
  DECLINED
}

// ---------- People & access ----------

model User {
  id                 String    @id @default(cuid())
  phone              String?   @unique
  email              String?   @unique
  name               String
  passwordHash       String? // staff only (scrypt)
  mfaSecret          String? // staff only, encrypted at rest
  roles              Role[]
  disabledAt         DateTime? // staff: deactivated by a super admin; can't sign in
  mustChangePassword Boolean   @default(false) // staff: signed in with a temporary password
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  talent            Talent?
  leads             Lead[]            @relation("CustomerLeads")
  ownedLeads        Lead[]            @relation("LeadOwner")
  favourites        Favourite[]
  sessions          Session[]
  auditEntries      AuditLog[]
  loginEvents       LoginEvent[]
  followUpsAssigned FollowUp[]        @relation("FollowUpAssignee")
  followUpsCreated  FollowUp[]        @relation("FollowUpCreator")
  notifications     NotificationSeen?
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique // HMAC of the rotating refresh token
  mfa              Boolean   @default(false) // staff roles only count on MFA sessions
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// AUTH-1: phone OTPs are stored hashed, single use, short-lived.
model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
}

model NotificationSeen {
  userId String   @id
  seenAt DateTime
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Catalogue ----------

model Category {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  blurb     String
  icon      String
  sortOrder Int              @default(0)
  talents   TalentCategory[]
}

model Talent {
  id                 String             @id @default(cuid())
  slug               String             @unique
  stageName          String
  headline           String
  bio                String
  baseCity           String
  travelsTo          String[]
  languages          String[]
  eventTypes         String[]
  tags               String[]
  tier               TalentTier         @default(STANDARD)
  status             ProfileStatus      @default(DRAFT)
  featured           Boolean            @default(false)
  blackoutSelfEdit   Boolean            @default(true) // TAL-3: the artist may edit their own calendar
  representationType RepresentationType
  feeBandMinPaise    BigInt? // public
  feeBandMaxPaise    BigInt? // public
  photoUrl           String
  galleryUrls        String[]
  pastEvents         Json               @default("[]") // [{ title, city, year }]
  userId             String?            @unique // talent portal login
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user       User?            @relation(fields: [userId], references: [id])
  categories TalentCategory[]
  rateCards  RateCard[]
  reps       TalentRep[]
  blackouts  Blackout[]
  bookings   Booking[]
  favourites Favourite[]

  @@index([status, tier])
}

model TalentCategory {
  talentId   String
  categoryId String
  talent     Talent   @relation(fields: [talentId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([talentId, categoryId])
  @@index([categoryId])
}

/// INTERNAL ONLY — never serialised to customers or talent.
model RateCard {
  id               String  @id @default(cuid())
  talentId         String
  eventType        String?
  minimumRatePaise BigInt
  sellingRatePaise BigInt
  payoutBps        Int // share of the artist fee paid out, e.g. 8000 = 80%
  notes            String?
  talent           Talent  @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@index([talentId])
}

model Representative {
  id             String             @id @default(cuid())
  name           String
  agencyName     String?
  phone          String
  email          String?
  verification   VerificationStatus @default(PENDING)
  kycDocumentIds String[]
  talents        TalentRep[]
}

model TalentRep {
  talentId String
  repId    String
  talent   Talent         @relation(fields: [talentId], references: [id], onDelete: Cascade)
  rep      Representative @relation(fields: [repId], references: [id], onDelete: Cascade)

  @@id([talentId, repId])
  @@index([repId])
}

model Blackout {
  id        String   @id @default(cuid())
  talentId  String
  date      String // ISO calendar date in India time, e.g. 2026-12-31
  note      String?
  locked    Boolean  @default(false) // set by the talent team; the artist can't clear it
  bookingId String?  @unique // set when a confirmed booking holds the date; cleared if it's cancelled
  talent    Talent   @relation(fields: [talentId], references: [id], onDelete: Cascade)
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([talentId, date])
}

model Favourite {
  userId    String
  talentId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  talent    Talent   @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@id([userId, talentId])
  @@index([talentId])
}

// ---------- Pipeline ----------

model Lead {
  id             String    @id @default(cuid())
  ref            String    @unique // TB-2026-000123
  stage          LeadStage @default(NEW)
  ownerId        String?
  customerId     String
  eventType      String
  eventDate      String // ISO calendar date (IST)
  altDate        String?
  city           String
  venue          String?
  audienceSize   Int?
  durationMins   Int?
  budgetMinPaise BigInt?
  budgetMaxPaise BigInt?
  language       String?
  notes          String?
  contactName    String
  contactEmail   String?
  companyName    String?
  gstin          String?
  source         String?
  lostReason     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  owner      User?      @relation("LeadOwner", fields: [ownerId], references: [id])
  customer   User       @relation("CustomerLeads", fields: [customerId], references: [id])
  bookings   Booking[]
  activities Activity[]
  messages   Message[]
  followUps  FollowUp[]

  @@index([stage, ownerId])
  @@index([eventDate])
  @@index([customerId])
}

model Booking {
  id                String             @id @default(cuid())
  leadId            String
  talentId          String
  availability      AvailabilityStatus @default(NOT_CHECKED)
  repAcceptedAt     DateTime?
  confirmedAt       DateTime?
  completedAt       DateTime?
  completionNote    String?
  cancelledAt       DateTime?
  cancelReason      String?
  sellingTotalPaise BigInt? // from the accepted quote
  payoutTotalPaise  BigInt? // INTERNAL (+ the talent sees their own)
  marginPaise       BigInt? // INTERNAL
  opsChecklist      Json?
  createdAt         DateTime           @default(now())

  lead       Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  talent     Talent             @relation(fields: [talentId], references: [id])
  quotes     Quote[]
  contracts  Contract[]
  milestones PaymentMilestone[]
  payout     Payout?
  blackout   Blackout?
  messages   Message[]

  @@unique([leadId, talentId])
  @@index([talentId])
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  actorId   String?
  title     String
  body      String?
  internal  Boolean  @default(false) // staff-only notes never reach the customer timeline
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

/// CUS-3: a thread per lead (customer ↔ manager) or per booking (talent ↔ team).
model Message {
  id         String        @id @default(cuid())
  leadId     String?
  bookingId  String?
  author     MessageAuthor
  authorId   String?
  authorName String
  body       String
  createdAt  DateTime      @default(now())
  lead       Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  booking    Booking?      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([bookingId, createdAt])
}

// ---------- Quotes, contracts, money ----------

model Quote {
  id                String          @id @default(cuid())
  bookingId         String
  version           Int
  status            QuoteStatus     @default(DRAFT)
  validUntil        DateTime
  subtotalPaise     BigInt
  taxPaise          BigInt
  totalPaise        BigInt
  internalCostPaise BigInt // INTERNAL
  milestonePlan     Json // [{ label, percentBps }]
  changeRequest     String?
  acceptedAt        DateTime?
  acceptedByUserId  String?
  acceptedIp        String?
  approvedById      String?
  createdAt         DateTime        @default(now())
  booking           Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lineItems         QuoteLineItem[]

  @@unique([bookingId, version])
}

model QuoteLineItem {
  id                  String       @id @default(cuid())
  quoteId             String
  position            Int
  type                LineItemType
  description         String
  customerAmountPaise BigInt
  internalCostPaise   BigInt // INTERNAL
  taxRateBps          Int // 1800 = 18%
  quote               Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model Contract {
  id          String         @id @default(cuid())
  bookingId   String
  status      ContractStatus @default(DRAFT)
  documentId  String?
  providerRef String?
  sentAt      DateTime?
  signedAt    DateTime?
  signedName  String?
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model PaymentMilestone {
  id            String          @id @default(cuid())
  bookingId     String
  label         String // "Advance", "Balance"
  amountPaise   BigInt
  dueDate       DateTime
  status        MilestoneStatus @default(PENDING)
  isAdvance     Boolean         @default(false)
  gatewayLinkId String?
  paidAt        DateTime?
  booking       Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@index([status, dueDate])
  @@index([bookingId])
}

model Payment {
  id               String           @id @default(cuid())
  milestoneId      String
  method           String // gateway method | bank_transfer
  gatewayPaymentId String?          @unique // or the bank UTR for manual entries
  amountPaise      BigInt
  status           String // captured | failed | refunded
  proofDocumentId  String?
  receivedAt       DateTime
  milestone        PaymentMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
}

model Payout {
  id          String       @id @default(cuid())
  bookingId   String       @unique
  amountPaise BigInt
  status      PayoutStatus @default(PENDING)
  reference   String?
  paidAt      DateTime?
  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

/// PAY-3: idempotency for gateway / e-sign webhooks.
model WebhookEvent {
  id          String    @id // provider event id
  provider    String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

model Document {
  id           String   @id @default(cuid())
  key          String
  mime         String
  size         Int
  kind         String
  ownerType    String
  ownerId      String
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([ownerType, ownerId])
}

// ---------- Public site intake ----------

model ContactRequest {
  id        String   @id @default(cuid())
  ref       String   @unique
  name      String
  phone     String
  email     String?
  topic     String
  message   String
  createdAt DateTime @default(now())
}

model TalentApplication {
  id             String            @id @default(cuid())
  ref            String            @unique
  stageName      String
  category       String
  city           String
  phone          String
  email          String
  representation String
  links          String
  about          String
  status         ApplicationStatus @default(NEW)
  createdAt      DateTime          @default(now())

  @@index([phone])
}

model NewsletterSubscriber {
  email     String   @id // stored lowercase
  createdAt DateTime @default(now())
}

// ---------- Audit (AUD-1…3) ----------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String
  action    String
  entity    String
  entityId  String
  summary   String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Reference counters (TB-2026-000123, CR-…, AP-…), incremented atomically.
model Counter {
  name  String @id
  value Int    @default(0)
}

// ---------- Notifications outbox (NOT-1…8) ----------

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Written in the same transaction as the business event; apps/worker sends them.
/// A rolled-back change never notifies, and a failed send is retried with backoff.
model Notification {
  id        String              @id @default(cuid())
  event     String // e.g. "quote.sent", "booking.confirmed"
  channel   NotificationChannel
  to        String // phone (SMS/WhatsApp) or email address
  subject   String?
  body      String
  leadId    String?
  status    NotificationStatus  @default(PENDING)
  attempts  Int                 @default(0)
  lastError String?
  sendAfter DateTime            @default(now())
  sentAt    DateTime?
  /// Scheduled reminders use a key so the same reminder is never queued twice.
  dedupeKey String?             @unique
  createdAt DateTime            @default(now())

  @@index([status, sendAfter])
  @@index([leadId])
}

/// Uploaded images (hero photos). Stored in the database so every API instance can serve them.
model Media {
  id        String   @id @default(cuid())
  mime      String
  bytes     Bytes
  width     Int
  height    Int
  size      Int
  createdAt DateTime @default(now())

  heroSlides HeroSlide[]
}

/// Home page hero carousel, edited by super admins.
model HeroSlide {
  id           String   @id @default(cuid())
  position     Int
  active       Boolean  @default(true)
  /// A bundled image path (e.g. /images/hero.jpg) when no upload is set.
  imagePath    String?
  imageId      String?
  imageAlt     String
  eyebrow      String
  title        String
  accent       String
  body         String
  ctaLabel     String
  ctaHref      String
  /// "left" or "right": the side of the photo the text sits on (pick the emptier side).
  textPosition String   @default("left")
  updatedAt    DateTime @updatedAt

  image Media? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([active, position])
}

/// Sign-in history for staff, customers and artists: successes, failures, sign-outs, password changes.
/// Read by the super admin (CRM → Audit log → Sign-ins); the worker prunes entries older than 180 days.
model LoginEvent {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  userId     String?
  /// What was typed: an email for staff, a phone number for customers and artists.
  identifier String
  userName   String?
  /// "staff" | "customer" | "talent"
  audience   String
  /// "sign_in" | "sign_in_failed" | "sign_out" | "password_changed"
  event      String
  /// Human-readable reason or note, e.g. "Wrong password", "New account", "Authenticator set up".
  detail     String?
  ip         String?
  userAgent  String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([audience, event, createdAt])
}

/// Sales follow-ups on a lead ("call back Friday 10 am"). The worker reminds the assignee when one falls due.
model FollowUp {
  id             String    @id @default(cuid())
  leadId         String
  assigneeId     String
  createdById    String
  title          String
  note           String?
  dueAt          DateTime
  doneAt         DateTime?
  doneById       String?
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee  User @relation("FollowUpAssignee", fields: [assigneeId], references: [id])
  createdBy User @relation("FollowUpCreator", fields: [createdById], references: [id])

  @@index([leadId])
  @@index([assigneeId, doneAt, dueAt])
  @@index([doneAt, reminderSentAt, dueAt])
}

/// Nightly payment reconciliation (apps/worker reconcile-payments; Accounts can also run it from the CRM).
/// Cross-checks milestones, captured payments, webhooks and payouts; `findings` lists every mismatch.
model ReconciliationRun {
  id         String   @id @default(cuid())
  ranAt      DateTime @default(now())
  /// "schedule" or the staff member's name for a manual run
  trigger    String
  ok         Boolean
  errorCount Int
  warnCount  Int
  /// [{ code, severity, message, leadId, ref, amountPaise? }]
  findings   Json
  /// { capturedPaise, paidMilestones, payoutsPaidPaise, checkedMilestones, checkedPayouts }
  totals     Json
  durationMs Int

  @@index([ranAt])
}
