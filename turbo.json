{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^generate",
        "generate",
        "typecheck"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^generate",
        "generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^generate",
        "generate"
      ]
    },
    "generate": {
      "inputs": [
        "prisma/schema.prisma"
      ],
      "outputs": [
        "src/generated/**"
      ]
    }
  }
}
